{
  "Deklarasi Pembolehubah (ada)": {
    "prefix": "ada",
    "body": [
      "ada ${1:nama} = ${2:nilai}"
    ],
    "description": "Deklarasi pembolehubah mutabel"
  },
  "Deklarasi Pemalar (tetap)": {
    "prefix": "tetap",
    "body": [
      "tetap ${1:NAMA} = ${2:nilai}"
    ],
    "description": "Deklarasi pemalar malar (tidak boleh ubah)"
  },
  "Deklarasi Fungsi (kerja)": {
    "prefix": "kerja",
    "body": [
      "kerja ${1:namaFungsi}(${2:parameter})",
      "\t${3:# kod anda}",
      "\tpulang ${4:nilai}",
      "selesai"
    ],
    "description": "Blok deklarasi fungsi Melayu"
  },
  "Syarat Jika (jika)": {
    "prefix": "jika",
    "body": [
      "jika ${1:syarat}",
      "\t${2:# blok laksana}",
      "selesai"
    ],
    "description": "Blok syarat jika"
  },
  "Syarat Jika-Tidak (jika ... jika tidak)": {
    "prefix": "jikatidak",
    "body": [
      "jika ${1:syarat}",
      "\t${2:# jika benar}",
      "jika tidak",
      "\t${3:# jika salah}",
      "selesai"
    ],
    "description": "Blok syarat jika berserta alternatif"
  },
  "Gelung Selagi (selagi)": {
    "prefix": "selagi",
    "body": [
      "selagi ${1:syarat}",
      "\t${2:# badan gelung}",
      "selesai"
    ],
    "description": "Gelung berasaskan syarat (while loop)"
  },
  "Gelung Elemen (untuk ... dalam)": {
    "prefix": "untukdalam",
    "body": [
      "untuk ${1:item} dalam ${2:senarai}",
      "\ttunjuk ${1:item}",
      "selesai"
    ],
    "description": "Gelung lelaran elemen senarai (for-in loop)"
  },
  "Gelung Julat (untuk ... dari ... hingga)": {
    "prefix": "untukjulat",
    "body": [
      "untuk ${1:i} dari ${2:1} hingga ${3:10}",
      "\ttunjuk ${1:i}",
      "selesai"
    ],
    "description": "Gelung julat angka (for-range loop)"
  },
  "Pengendalian Ralat (cuba ... tangkap)": {
    "prefix": "cuba",
    "body": [
      "cuba",
      "\t${1:# operasi berisiko}",
      "tangkap ${2:ralat}",
      "\ttunjuk \"Ralat dikesan: \" + ${2:ralat}",
      "selesai"
    ],
    "description": "Blok perlindungan dan tangkapan ralat"
  },
  "Import Modul (ambil)": {
    "prefix": "ambil",
    "body": [
      "ambil \"${1:modul.ml}\""
    ],
    "description": "Import keseluruhan fail modul"
  },
  "Import Modul Sebagai Alias (ambil sebagai)": {
    "prefix": "ambilsebagai",
    "body": [
      "ambil \"${1:modul.ml}\" sebagai ${2:alias}"
    ],
    "description": "Import modul ke dalam ruang nama kamus"
  },
  "Import Simbol Terpilih (ambil daripada)": {
    "prefix": "ambildaripada",
    "body": [
      "ambil ${1:fungsi} daripada \"${2:modul.ml}\""
    ],
    "description": "Import fungsi atau pembolehubah terpilih daripada fail modul"
  },
  "Papar Output (tunjuk)": {
    "prefix": "tunjuk",
    "body": [
      "tunjuk ${1:mesej}"
    ],
    "description": "Mencetak mesej ke terminal"
  },
  "Hurai JSON (bacaJSON)": {
    "prefix": "bacajson",
    "body": [
      "ada ${1:data} = bacaJSON(${2:teksJSON})"
    ],
    "description": "Menghurai teks JSON kepada kamus atau senarai MELAYU"
  },
  "Tulis JSON (tulisJSON)": {
    "prefix": "tulisjson",
    "body": [
      "ada ${1:teks} = tulisJSON(${2:data}, ${3:betul})"
    ],
    "description": "Menukar data MELAYU kepada teks JSON (cantik atau padat)"
  },
  "Petakan Senarai (.petakan)": {
    "prefix": "petakan",
    "body": [
      "ada ${1:hasil} = ${2:senarai}.petakan(${3:fungsiPenukar})"
    ],
    "description": "Operasi fungsian map pada senarai"
  },
  "Tapis Senarai (.tapis)": {
    "prefix": "tapis",
    "body": [
      "ada ${1:hasil} = ${2:senarai}.tapis(${3:fungsiSyarat})"
    ],
    "description": "Operasi fungsian filter pada senarai"
  },
  "Kira Semua Senarai (.kiraSemua)": {
    "prefix": "kirasemua",
    "body": [
      "ada ${1:jumlah} = ${2:senarai}.kiraSemua(${3:fungsiAkumulasi}, ${4:0})"
    ],
    "description": "Operasi fungsian reduce pada senarai"
  },
  "Cap Masa Semasa (capMasa)": {
    "prefix": "capmasa",
    "body": [
      "ada ${1:masaEpoch} = capMasa()"
    ],
    "description": "Mendapatkan cap masa Unix semasa dalam saat"
  },
  "Tarikh & Masa Kini": {
    "prefix": "masakini",
    "body": [
      "ada ${1:tarikh} = tarikhKini()",
      "ada ${2:masa} = masaKini()"
    ],
    "description": "Mendapatkan tarikh dan masa kalendar semasa"
  },
  "Deklarasi Kelas (kelas)": {
    "prefix": "kelas",
    "body": [
      "kelas ${1:NamaKelas}",
      "\tbina(${2:parameter})",
      "\t\tdiri.${3:sifat} = ${2:parameter}",
      "\tselesai",
      "",
      "\tkerja ${4:namaKaedah}()",
      "\t\tpulang diri.${3:sifat}",
      "\tselesai",
      "selesai"
    ],
    "description": "Blok deklarasi kelas Pengaturcaraan Berorientasikan Objek (OOP)"
  },
  "Deklarasi Kelas Warisi (kelas ... warisi)": {
    "prefix": "kelaswarisi",
    "body": [
      "kelas ${1:NamaSubKelas} warisi ${2:NamaInduk}",
      "\tbina(${3:parameter}, ${4:sifatTambahan})",
      "\t\tinduk.bina(${3:parameter})",
      "\t\tdiri.${4:sifatTambahan} = ${4:sifatTambahan}",
      "\tselesai",
      "",
      "\tkerja ${5:namaKaedah}()",
      "\t\tpulang induk.${5:namaKaedah}()",
      "\tselesai",
      "selesai"
    ],
    "description": "Blok deklarasi kelas anak mewarisi kelas induk"
  },
  "Pembina Kelas (bina)": {
    "prefix": "bina",
    "body": [
      "bina(${1:parameter})",
      "\tdiri.${2:sifat} = ${1:parameter}",
      "selesai"
    ],
    "description": "Pembina objek dalam kelas (constructor)"
  },
  "Kaedah Instans Kelas (kaedah)": {
    "prefix": "kaedah",
    "body": [
      "kerja ${1:namaKaedah}(${2:parameter})",
      "\t${3:# logik kaedah}",
      "\tpulang ${4:nilai}",
      "selesai"
    ],
    "description": "Kaedah fungsi di dalam blok kelas"
  },
  "Pengesahan Syarat (semak)": {
    "prefix": "semak",
    "body": [
      "semak ${1:syarat}, \"${2:Mesej ralat sekiranya gagal}\""
    ],
    "description": "Pernyataan semakan penegasan (assertion)"
  },
  "Padanan Corak (padan)": {
    "prefix": "padan",
    "body": [
      "padan ${1:sasaran}",
      "\tbila ${2:pola} => ${3:hasil}",
      "\tlain => ${4:lalai}",
      "selesai"
    ],
    "description": "Blok padanan corak ekspresif (pattern matching)"
  },
  "Ujian Unit (uji)": {
    "prefix": "uji",
    "body": [
      "uji \"${1:Tajuk Ujian}\"",
      "\tada ${2:hasil} = ${3:kiraan}",
      "\tsemak ${2:hasil} == ${4:dijangka}, \"${5:Penjelasan ralat}\"",
      "selesai"
    ],
    "description": "Blok ujian unit terbina-dalam Melayu"
  },
  "Saluran Paip (paip)": {
    "prefix": "paip",
    "body": [
      "${1:data} |> ${2:fungsi1} |> ${3:fungsi2}"
    ],
    "description": "Rantaian saluran paip data (|>) Melayu"
  }
}

